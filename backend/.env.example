# Copy to `backend/.env` for local development (pydantic-settings reads
# `.env` relative to the process's working directory, which is `backend/`
# per the documented `cd backend && uvicorn app.main:app --reload` startup —
# a `.env` at the repo root is NOT read). Settings are read with the
# STRATA_ prefix (see app/core/config.py). Nothing in this file is a real
# secret.

# --- General ---
STRATA_ENVIRONMENT=development
STRATA_LOG_LEVEL=INFO
STRATA_LOG_JSON=false

# --- API ---
STRATA_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- Storage backend: local | gcs (gcs not implemented yet) ---
STRATA_STORAGE_BACKEND=local
STRATA_LOCAL_STORAGE_DIR=./data

# --- Repository backend: memory | firestore (firestore not implemented yet) ---
STRATA_REPOSITORY_BACKEND=memory

# --- Google Cloud (reserved for future Cloud Storage / Firestore backends) ---
STRATA_GCP_PROJECT_ID=
STRATA_GCS_BUCKET_NAME=
STRATA_FIRESTORE_DATABASE=

# --- PrusaSlicer ---
STRATA_PRUSASLICER_BINARY_PATH=prusa-slicer
STRATA_PRUSASLICER_TIMEOUT_SECONDS=300

# --- Agent planner: deterministic (default, offline/free) | gemini ---
# "gemini" uses Gemini + Google ADK (app/agent/gemini_planner.py) to propose
# the first round of candidates, deterministically validated before any
# slicing happens. The server refuses to start in "gemini" mode without
# STRATA_GEMINI_API_KEY set — no silent fallback to deterministic mode.
# Get a key at https://aistudio.google.com/apikey
STRATA_PLANNER_MODE=deterministic
STRATA_GEMINI_API_KEY=
STRATA_GEMINI_MODEL=gemini-3.5-flash
